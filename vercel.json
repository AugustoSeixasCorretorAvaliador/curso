{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/portal.js": {
      "includeFiles": "lib/conteudo.enc"
    }
  },
  "routes": [
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/curso/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/curso(?:/(.*))?",
      "dest": "/api/portal?rota=$1"
    }
  ]
}
